{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "read": {
      "**/.env": "deny",
      "**/secrets.json": "deny",
      "*": "allow"
    },
    "bash": {
      "git *": "allow",
      "npm *": "allow",
      "ls": "allow",
      "rm *": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "task": {
      "*": "ask"
    }
  }
}
