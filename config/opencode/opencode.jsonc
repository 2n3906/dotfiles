{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "**/.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/secrets.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "npm *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
